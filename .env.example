# Names only. Copy to .env.local and fill in. Never commit real values.

# PayPal sandbox REST app (developer.paypal.com > Apps & Credentials > Sandbox).
# The app needs Payouts and Transaction search enabled. Sandbox only.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Same value as PAYPAL_CLIENT_ID (reserved for browser checkout; this build pays server-side).
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Three sandbox personal accounts (developer.paypal.com > Testing Tools > Sandbox Accounts), comma-separated.
PAYPAL_SANDBOX_WORKER_EMAILS=
# A sandbox personal account for a customer. Not needed by this build: orders are paid with a sandbox test card.
PAYPAL_SANDBOX_BUYER_EMAIL=
PAYPAL_SANDBOX_BUYER_PASSWORD=
# Printed by `pnpm paypal:webhook <public-url>` after deploying.
PAYPAL_WEBHOOK_ID=

# AG Studio licence key (45-day trial from ag-grid.com). Blank works, with a watermark.
AG_STUDIO_LICENSE=

# OpenAI-compatible inference (W&B Inference). Server-side only.
OPENAI_BASE_URL=https://api.inference.wandb.ai/v1
OPENAI_API_KEY=
OPENAI_MODEL=Qwen/Qwen3.8-27B
OPENAI_VISION_MODEL=google/gemma-4-31B-it
OPENAI_FALLBACK_MODEL=zai-org/GLM-5.3-Flash

# Only used to make the video narration and Rio's pre-rendered voice lines (scripts/voice.ts).
ELEVENLABS_API_KEY=

# Generate yourself: openssl rand -hex 24. Protects POST /api/admin/reset (header x-admin-token).
DEMO_ADMIN_TOKEN=

# Set by Vercel when a Blob store is attached. Without it, state lives in .data/ files.
BLOB_READ_WRITE_TOKEN=
